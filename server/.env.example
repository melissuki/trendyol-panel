# ---------------------------------------------------------------------------
# SUNUCU
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Virgulle ayrilmis izinli frontend originleri (strict CORS).
# Uretimde SADECE kendi domaininizi yazin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# TRENDYOL API KIMLIK BILGILERI  (Trendyol Partner > Hesap Bilgileri > Entegrasyon)
# BU DEGERLER ASLA FRONTEND'E GONDERILMEZ.
# ---------------------------------------------------------------------------
TRENDYOL_SELLER_ID=123456
TRENDYOL_API_KEY=your_api_key_here
TRENDYOL_API_SECRET=your_api_secret_here

# Yeni API gateway (onerilen). Eski adres: https://api.trendyol.com/sapigw
TRENDYOL_BASE_URL=https://apigw.trendyol.com/integration
# User-Agent sonundaki etiket: "SelfIntegration" veya entegrator adiniz
TRENDYOL_INTEGRATION_TAG=SelfIntegration
TRENDYOL_TIMEOUT_MS=30000
TRENDYOL_MAX_RETRIES=4

# ---------------------------------------------------------------------------
# YONETICI GIRISI  (ZORUNLU - uretimde sunucu bunlar olmadan ACILMAZ)
#
# Olusturmak icin:   npm run auth:hash
# Duz parola HICBIR yerde saklanmaz; asagida yalnizca bcrypt ozeti tutulur.
# ---------------------------------------------------------------------------
ADMIN_USERNAME=
# bcrypt ozeti - or. $2b$12$....  (npm run auth:hash ciktisindan yapistirin)
ADMIN_PASSWORD_HASH=
# En az 32 karakter rastgele deger. Degistirilirse tum oturumlar duser.
JWT_SECRET=
# Oturum omru: 30m, 8h, 7d ...
JWT_EXPIRES_IN=8h
JWT_ISSUER=trendyol-analytics
# Kaba kuvvet korumasi: pencere basina izin verilen basarisiz giris denemesi
AUTH_MAX_ATTEMPTS=5
AUTH_WINDOW_MINUTES=15

# ---------------------------------------------------------------------------
# FINANS / KESINTILER
#
# ONEMLI: Komisyon, kargo ve hizmet kesintileri ARTIK TAHMIN EDILMEZ.
# Tum tutarlar Trendyol Mutabakat (Settlement) API'sinden ISLEM BAZINDA okunur.
# Bu nedenle asagidaki eski ayarlar KALDIRILMISTIR ve artik kullanilmaz:
#     DEFAULT_COMMISSION_RATE, SHIPPING_COST_PER_ORDER,
#     RETURN_SHIPPING_COST, COMMISSION_REFUNDED_ON_RETURN, USE_FINANCE_API
#
# Mutabakat kaydi henuz olusmamis satirlar "mutabakat bekliyor" olarak
# isaretlenir; tutarlari uydurulmaz. Bunun icin Trendyol Partner hesabinizda
# FINANS API yetkisinin acik olmasi gerekir.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# DAVRANIS
# ---------------------------------------------------------------------------
# Iade kargo bedeli (TL/adet). YALNIZCA IADE satirlarina uygulanir; iptallerde
# uygulanmaz. Trendyol mutabakati bu kalemi satir bazinda dondurmedigi icin tek
# yapilandirilabilir kalemdir; kullanan satirlar "Tahmini" olarak etiketlenir.
RETURN_SHIPPING_FEE=0

REPORT_TIMEZONE=Europe/Istanbul
CACHE_TTL_SECONDS=300
MAX_RANGE_DAYS=180
LOG_LEVEL=info
